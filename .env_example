# Copy this file to .env and set the paths for your computer.

# Folder of the SWMM_GNN_Metamodel repository (https://github.com/alextremo0205/SWMM_GNN_Metamodel)
METAMODEL_CODE_PATH=/path/to/SWMM_GNN_Metamodel

# Folder that contains the network folder "Loenen - v8"
DATA_FOLDER_PATH=./data

# Folder with the metamodel normalizer (saved_normalizers/)
SAVED_OBJECTS_FOLDER_PATH=./saved_objects

# Folder where the figures are saved
RESULTS_FOLDER_PATH=./results
